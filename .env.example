# Environment variables for Ashish Gupta Cyber Security Portfolio
# Copy this file to .env.local for local dev, and set the same values in
# Vercel → Settings → Environment Variables for production.

# ── Admin login (server-side) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-random-string

# ── AI providers for chat (OpenAI-compatible) ──
# Accepts any of these env var names for the URL/token:
#   TURSO_DATABASE_URL / TURSO_URL / TURSO_DB_URL / LIBSQL_URL
#   TURSO_AUTH_TOKEN / TURSO_API_KEY / TURSO_TOKEN / LIBSQL_AUTH_TOKEN
AI_PROVIDERS_JSON={"activeId":"p1","providers":[{"id":"p1","name":"XKiro","baseUrl":"https://api.xkiro.com/v1","apiKey":"sk-...","model":"qwen/qwen3.8-max:free","contextWindow":1000000,"maxOutput":65536}]}
AI_ALLOWED_HOSTS=api.xkiro.com

# ── Turso (libSQL) — multi-user device auth + conversations ──
# Set BOTH of these for Turso to work. If either is missing, the app
# silently falls back to localStorage (single-device, no persistence).
# You can use ANY of these names — the code checks all of them:
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# ── Provider encryption (Phase 9) ──
# Master key for AES-256-GCM encryption of admin-managed provider API keys.
# 32-byte hex — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Only this key lives in env; all provider keys are encrypted in Turso.
PROVIDER_ENCRYPTION_KEY=your-32-byte-hex-key-here

# ── SSRF defense: positive host allowlist ──
AI_ALLOWED_HOSTS=api.xkiro.com,top-tools-ai.com

# ── Chat rate limit ──
CHAT_RATE_LIMIT=10

# ── Image CSP hosts ──
AI_IMAGE_CSP_HOSTS=cdn.xkiro.com
AI_VIDEO_CSP_HOSTS=cdn.xkiro.com

# ── Admin session ──
ADMIN_SESSION_SECRET=change-me-to-a-long-random-hex-string
